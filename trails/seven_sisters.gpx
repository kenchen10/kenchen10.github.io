<?xml version="1.0" encoding="UTF-8"?>
<gpx xmlns="http://www.topografix.com/GPX/1/1" version="1.1" creator="kenchen10.github.io">
  <metadata>
    <name>Seaford to Eastbourne (Seven Sisters)</name>
    <desc>Seaford to Eastbourne along the coast: Seaford Head, Hope Gap, Cuckmere Haven (inland via Exceat Bridge), the Seven Sisters, Birling Gap, Belle Tout and Beachy Head. Route traced from the AllTrails "Seaford to Eastbourne" trail; elevation from EU-DEM 25 m via OpenTopoData (highest value within 20 m of each point, so the cliff edge is not averaged with the sea).</desc>
    <bounds minlat="50.735540" minlon="0.100400" maxlat="50.775330" maxlon="0.289340"/>
  </metadata>
